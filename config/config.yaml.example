WifiCountryCode: "US"
MotionRecordingTimeout: 120
AudioRecordingTimeout: 10
RecordOnMotionAlert: true
RecordOnAudioAlert: false
# Trailing slash required: paths are built by string concatenation.
RecordingBasePath: "/home/YOUR_USER/arlo/recordings/"

# GStreamer motion recorder (ffmpeg cannot open the Arlo Ultra's RTSP server)
MotionClipSeconds: 10       # seconds recorded per motion event
MotionRtspPort: 554         # 554 = H.264 1080p; 555 = 4K HEVC (Ultra only)
MotionRtspLatencyMs: 200

# Webhooks: leave blank to disable
MotionRecordingWebHookUrl: ""
AudioRecordingWebHookUrl: ""
UserRecordingWebHookUrl: ""
StatusUpdateWebHookUrl: ""
RegistrationWebHookUrl: ""
NotifyOnMotionAlert: true
NotifyOnAudioAlert: false
NotifyOnButtonPressAlert: true

# Ntfy Alert Configuration (Self-Hosted or ntfy.sh)
NtfyEnabled: false
NtfyUrl: "https://ntfy.sh"  # Or your self-hosted ntfy server
NtfyTopic: "your-arlo-alerts"
NtfyPriority: "high"  # Options: min, low, default, high, urgent
NtfyIncludeThumbnail: true  # Thumbnails generated from video files
NtfyThumbnailBaseUrl: "https://your-server.example.com/api/thumbnail"  # Thumbnail API endpoint
NtfyClickUrl: "https://your-server.example.com"  # Link to video viewer interface

# Camera Aliases (Friendly Names)
# Maps camera serial numbers to human-readable names for notifications and web viewer.
# Names must be unique. Serials are printed by `arlo-pair` when a camera registers.
CameraAliases:
  YOUR_CAMERA_SERIAL_1: "Front Door"
  YOUR_CAMERA_SERIAL_2: "Back Yard"

# Battery Warning Notifications
# Send alerts when camera battery crosses threshold levels
BatteryWarningEnabled: true
BatteryWarningLow: 25       # Send warning when battery drops below this percentage (priority: high)
BatteryWarningCritical: 10  # Send critical warning when battery drops below this percentage (priority: urgent)
