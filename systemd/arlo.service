# Reference copy: scripts/install.sh generates this with real paths.
[Unit]
Description=Arlo Control Service (arlo-cam-api)
After=network-online.target hostapd.service
Wants=network-online.target hostapd.service

[Service]
Type=simple
User=YOUR_USERNAME
Group=YOUR_USERNAME
WorkingDirectory=/home/YOUR_USERNAME/arlo/app
Environment=ARLO_LOG_FILE=/home/YOUR_USERNAME/arlo/logs/arlo-service.log
Environment=ARLO_AP_INTERFACE=wlan0
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/YOUR_USERNAME/arlo/app/venv/bin/python3 /home/YOUR_USERNAME/arlo/app/server.py
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
